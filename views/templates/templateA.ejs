<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= portfolio.profile.fullName || 'Portfolio' %> | Professional Profile</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @media print {
            .no-print { display: none !important; }
            body { background: #070B19 !important; color: #f8fafc !important; -webkit-print-color-adjust: exact; }
        }
    </style>
</head>
<body class="bg-[#070B19] text-slate-100 min-h-screen font-sans selection:bg-indigo-500 selection:text-white antialiased pb-12">

    <!-- Top Action Bar (Hidden in PDF) -->
    <header class="no-print max-w-5xl mx-auto px-6 pt-8 flex justify-between items-center">
        <a href="/dashboard" class="text-sm font-semibold text-indigo-400 hover:text-indigo-300 transition flex items-center gap-2">
            ← Back to Dashboard
        </a>
        <button onclick="window.print()" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium rounded-xl shadow-lg shadow-indigo-500/20 transition">
            Export PDF 🖨️
        </button>
    </header>

    <main class="max-w-5xl mx-auto px-6 py-10 space-y-10">

        <!-- Hero Card -->
        <section class="relative overflow-hidden bg-gradient-to-r from-slate-900/80 to-indigo-950/50 backdrop-blur-xl border border-white/10 rounded-3xl p-8 sm:p-12 shadow-2xl">
            <div class="absolute -right-20 -top-20 w-80 h-80 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
            
            <div class="flex flex-col md:flex-row items-center gap-8 relative z-10">
                <% if (portfolio.profile.profilePicture) { %>
                    <img src="<%= portfolio.profile.profilePicture %>" alt="<%= portfolio.profile.fullName %>" 
                        class="w-36 h-36 md:w-44 md:h-44 rounded-2xl object-cover border-2 border-indigo-500/40 shadow-2xl flex-shrink-0">
                <% } else { %>
                    <div class="w-36 h-36 md:w-44 md:h-44 rounded-2xl bg-gradient-to-tr from-indigo-600 to-blue-600 flex items-center justify-center text-5xl font-extrabold text-white shadow-2xl flex-shrink-0">
                        <%= portfolio.profile.fullName ? portfolio.profile.fullName.charAt(0) : 'S' %>
                    </div>
                <% } %>

                <div class="space-y-3 text-center md:text-left">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-semibold tracking-wider uppercase">
                        Student Portfolio
                    </div>
                    <h1 class="text-3xl md:text-5xl font-black tracking-tight text-white">
                        <%= portfolio.profile.fullName %>
                    </h1>
                    <% if (portfolio.profile.major || portfolio.profile.university) { %>
                        <p class="text-sm md:text-base font-medium text-indigo-200/80">
                            <%= portfolio.profile.major %> <% if (portfolio.profile.major && portfolio.profile.university) { %>•<% } %> <%= portfolio.profile.university %>
                        </p>
                    <% } %>
                    <% if (portfolio.profile.bio) { %>
                        <p class="text-gray-300 text-sm md:text-base leading-relaxed max-w-2xl pt-2">
                            <%= portfolio.profile.bio %>
                        </p>
                    <% } %>
                </div>
            </div>
        </section>

        <!-- Main Content Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

            <!-- Left Column (Skills & Academics) -->
            <div class="space-y-8">
                
                <!-- Skills Module -->
                <% if (portfolio.skills && portfolio.skills.length > 0) { %>
                    <section class="bg-slate-900/50 backdrop-blur-xl border border-white/10 rounded-2xl p-6 shadow-xl space-y-4">
                        <h2 class="text-lg font-bold text-indigo-300 flex items-center gap-2">🛠️ Technical Skills</h2>
                        <div class="flex flex-wrap gap-2">
                            <% portfolio.skills.forEach(skill => { %>
                                <span class="px-3.5 py-1.5 bg-white/5 border border-white/10 rounded-xl text-xs font-medium text-gray-200">
                                    <%= skill %>
                                </span>
                            <% }) %>
                        </div>
                    </section>
                <% } %>

                <!-- Academics Module -->
                <% if (portfolio.academics && portfolio.academics.length > 0) { %>
                    <section class="bg-slate-900/50 backdrop-blur-xl border border-white/10 rounded-2xl p-6 shadow-xl space-y-4">
                        <h2 class="text-lg font-bold text-indigo-300 flex items-center gap-2">🎓 Academics</h2>
                        <div class="space-y-3">
                            <% portfolio.academics.forEach(acad => { %>
                                <div class="bg-white/5 border border-white/10 rounded-xl p-3 flex justify-between items-center">
                                    <span class="text-sm font-medium text-gray-200"><%= acad.subject %></span>
                                    <span class="px-2.5 py-1 bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 rounded-lg text-xs font-bold">
                                        <%= acad.grade %>
                                    </span>
                                </div>
                            <% }) %>
                        </div>
                    </section>
                <% } %>

                <!-- Contact & Socials Module -->
                <% if (portfolio.socialLinks && (portfolio.socialLinks.linkedin || portfolio.socialLinks.github || portfolio.socialLinks.twitter || portfolio.socialLinks.website)) { %>
                    <section class="bg-slate-900/50 backdrop-blur-xl border border-white/10 rounded-2xl p-6 shadow-xl space-y-4">
                        <h2 class="text-lg font-bold text-indigo-300 flex items-center gap-2">🌐 Connect</h2>
                        <div class="flex flex-col gap-2.5">
                            <% if (portfolio.socialLinks.linkedin) { %>
                                <a href="<%= portfolio.socialLinks.linkedin %>" target="_blank" class="px-4 py-2.5 bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl text-xs font-semibold text-gray-200 transition flex items-center justify-between">
                                    <span>LinkedIn Profile</span> ↗
                                </a>
                            <% } %>
                            <% if (portfolio.socialLinks.github) { %>
                                <a href="<%= portfolio.socialLinks.github %>" target="_blank" class="px-4 py-2.5 bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl text-xs font-semibold text-gray-200 transition flex items-center justify-between">
                                    <span>GitHub Repository</span> ↗
                                </a>
                            <% } %>
                            <% if (portfolio.socialLinks.twitter) { %>
                                <a href="<%= portfolio.socialLinks.twitter %>" target="_blank" class="px-4 py-2.5 bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl text-xs font-semibold text-gray-200 transition flex items-center justify-between">
                                    <span>Twitter / X</span> ↗
                                </a>
                            <% } %>
                            <% if (portfolio.socialLinks.website) { %>
                                <a href="<%= portfolio.socialLinks.website %>" target="_blank" class="px-4 py-2.5 bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl text-xs font-semibold text-gray-200 transition flex items-center justify-between">
                                    <span>Personal Website</span> ↗
                                </a>
                            <% } %>
                        </div>
                    </section>
                <% } %>

            </div>

            <!-- Right Column (Projects & Achievements) -->
            <div class="lg:col-span-2 space-y-8">

                <!-- Projects Module -->
                <% if (portfolio.projects && portfolio.projects.length > 0) { %>
                    <section class="space-y-4">
                        <h2 class="text-xl font-bold tracking-tight text-indigo-300 flex items-center gap-2">💼 Featured Projects</h2>
                        <div class="space-y-6">
                            <% portfolio.projects.forEach(proj => { %>
                                <div class="bg-slate-900/50 backdrop-blur-xl border border-white/10 rounded-2xl p-6 shadow-xl space-y-3 transition hover:border-indigo-500/40">
                                    <h3 class="text-lg font-bold text-white"><%= proj.title %></h3>
                                    <p class="text-sm text-gray-300 leading-relaxed"><%= proj.description %></p>
                                    <% if (proj.image) { %>
                                        <div class="mt-3 overflow-hidden rounded-xl border border-white/10 h-48 bg-slate-800">
                                            <img src="<%= proj.image %>" alt="<%= proj.title %>" class="w-full h-full object-cover">
                                        </div>
                                    <% } %>
                                    <% if (proj.technologies) { %>
                                        <div class="pt-2 flex flex-wrap gap-2">
                                            <% proj.technologies.split(',').forEach(tech => { %>
                                                <span class="px-2.5 py-1 bg-indigo-950/60 border border-indigo-500/20 text-indigo-300 rounded-lg text-xs font-semibold">
                                                    <%= tech.trim() %>
                                                </span>
                                            <% }) %>
                                        </div>
                                    <% } %>
                                </div>
                            <% }) %>
                        </div>
                    </section>
                <% } %>

                <!-- Achievements Module -->
                <% if (portfolio.achievements && portfolio.achievements.length > 0) { %>
                    <section class="space-y-4">
                        <h2 class="text-xl font-bold tracking-tight text-indigo-300 flex items-center gap-2">🏆 Achievements & Certifications</h2>
                        <div class="space-y-4">
                            <% portfolio.achievements.forEach(ach => { %>
                                <div class="bg-slate-900/50 backdrop-blur-xl border border-white/10 rounded-2xl p-6 shadow-xl space-y-2">
                                    <h3 class="text-base font-bold text-white"><%= ach.title %></h3>
                                    <p class="text-sm text-gray-300 leading-relaxed"><%= ach.description %></p>
                                    <% if (ach.image) { %>
                                        <div class="mt-3 overflow-hidden rounded-xl border border-white/10 h-32 bg-slate-800">
                                            <img src="<%= ach.image %>" alt="Certificate" class="w-full h-full object-cover">
                                        </div>
                                    <% } %>
                                </div>
                            <% }) %>
                        </div>
                    </section>
                <% } %>

            </div>

        </div>

        <!-- ========================================== -->
        <!-- DOWNLOAD PDF BUTTON (Bottom & Hidden in PDF) -->
        <!-- ========================================== -->
        <div class="no-print pt-8 flex justify-center">
            <a href="/portfolio/download" 
               class="group relative inline-flex items-center gap-3 px-8 py-4 bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-500 hover:to-indigo-500 text-white font-bold rounded-2xl shadow-xl shadow-indigo-600/35 transition-all duration-300 transform hover:-translate-y-0.5">
                <i class="fas fa-file-pdf text-xl transition-transform group-hover:scale-110"></i>
                Download Professional PDF Portfolio
            </a>
        </div>

    </main>

</body>
</html>