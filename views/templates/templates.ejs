<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Select Portfolio Template - Edufolio Builder</title>
    
    <!-- Google Fonts: Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- AOS Animation CSS -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Poppins', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-gray-50 dark:bg-slate-900 text-gray-800 dark:text-gray-200 font-sans antialiased min-h-screen flex flex-col relative overflow-x-hidden">

    <!-- Background Gradient Decorators -->
    <div class="fixed top-[-10%] left-[-10%] w-96 h-96 bg-blue-500/20 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-blob dark:mix-blend-overlay -z-10"></div>
    <div class="fixed top-[20%] right-[-10%] w-96 h-96 bg-purple-500/20 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-blob animation-delay-2000 dark:mix-blend-overlay -z-10"></div>

    <!-- Navigation -->
    <nav class="w-full z-50 top-0 transition-all duration-300 backdrop-blur-md bg-white/70 dark:bg-slate-900/70 border-b border-gray-200 dark:border-gray-800 shadow-sm sticky">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <div class="flex-shrink-0 flex items-center">
                    <span class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-purple-600">
                        <i class="fas fa-layer-group mr-2"></i>Edufolio Builder
                    </span>
                </div>
                <div class="flex items-center space-x-6">
                    <a href="/dashboard" class="text-gray-600 hover:text-blue-600 dark:text-gray-300 dark:hover:text-blue-400 font-medium transition-colors">
                        <i class="fas fa-arrow-left mr-1"></i> Back to Dashboard
                    </a>
                    <button id="theme-toggle" class="p-2 rounded-full bg-gray-200 dark:bg-gray-800 hover:bg-gray-300 dark:hover:bg-gray-700 transition-colors focus:outline-none shadow-inner">
                        <i class="fas fa-moon text-gray-800 dark:text-white" id="theme-icon"></i>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
        
        <!-- Header Section -->
        <div class="text-center mb-16" data-aos="fade-up">
            <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 dark:text-white mb-4">Choose Your <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-purple-600">Template</span></h1>
            <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">Select a professional design to generate your dynamic portfolio. You can switch templates at any time without losing your data.</p>
            <div class="w-24 h-1 bg-gradient-to-r from-blue-600 to-purple-600 mx-auto rounded-full mt-8"></div>
        </div>

        <!-- Templates Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
            
            <!-- Template A Card -->
            <div class="glass-card bg-white/80 dark:bg-slate-800/80 backdrop-blur-xl rounded-2xl overflow-hidden border border-gray-200 dark:border-slate-700 shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 flex flex-col" data-aos="fade-right" data-aos-delay="100">
                
                <!-- Preview Image -->
                <div class="h-64 overflow-hidden relative border-b border-gray-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-900">
                    <!-- Placeholder representing a top-nav layout -->
                    <img src="https://images.unsplash.com/photo-1507238691740-187a5b1d37b8?q=80&w=800&auto=format&fit=crop" alt="Template A Preview" class="w-full h-full object-cover opacity-90 hover:opacity-100 transition-opacity duration-300">
                    <div class="absolute top-4 left-4 bg-blue-600 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow-lg">Most Popular</div>
                </div>

                <!-- Content -->
                <div class="p-8 flex flex-col flex-grow">
                    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">Modern Gradient</h2>
                    <p class="text-gray-600 dark:text-gray-400 text-sm mb-6 flex-grow">A sleek, top-navigation layout featuring an animated gradient hero section, centered profile imagery, and responsive grid cards.</p>
                    
                    <!-- Features List -->
                    <ul class="space-y-3 mb-8">
                        <li class="flex items-center text-sm text-gray-700 dark:text-gray-300 font-medium">
                            <i class="fas fa-check-circle text-blue-500 mr-3 text-lg"></i> Sticky Top Navigation
                        </li>
                        <li class="flex items-center text-sm text-gray-700 dark:text-gray-300 font-medium">
                            <i class="fas fa-check-circle text-blue-500 mr-3 text-lg"></i> Animated Blob Backgrounds
                        </li>
                        <li class="flex items-center text-sm text-gray-700 dark:text-gray-300 font-medium">
                            <i class="fas fa-check-circle text-blue-500 mr-3 text-lg"></i> Center-aligned Hero Section
                        </li>
                        <li class="flex items-center text-sm text-gray-700 dark:text-gray-300 font-medium">
                            <i class="fas fa-check-circle text-blue-500 mr-3 text-lg"></i> Glassmorphism Project Cards
                        </li>
                    </ul>

                    <!-- Action Button (Update href to match your exact route) -->
                    <a href="/portfolio/templateA" class="w-full block text-center py-4 rounded-xl bg-gradient-to-r from-blue-600 to-purple-600 text-white font-bold text-lg hover:shadow-lg hover:shadow-blue-500/40 transform transition-all duration-300">
                        Use Template A
                    </a>
                </div>
            </div>

            <!-- Template B Card -->
            <div class="glass-card bg-white/80 dark:bg-slate-800/80 backdrop-blur-xl rounded-2xl overflow-hidden border border-gray-200 dark:border-slate-700 shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 flex flex-col" data-aos="fade-left" data-aos-delay="200">
                
                <!-- Preview Image -->
                <div class="h-64 overflow-hidden relative border-b border-gray-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-900">
                    <!-- Placeholder representing a sidebar layout -->
                    <img src="https://images.unsplash.com/photo-1517694712202-14dd9538aa97?q=80&w=800&auto=format&fit=crop" alt="Template B Preview" class="w-full h-full object-cover opacity-90 hover:opacity-100 transition-opacity duration-300">
                    <div class="absolute top-4 left-4 bg-purple-600 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow-lg">Professional</div>
                </div>

                <!-- Content -->
                <div class="p-8 flex flex-col flex-grow">
                    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">Professional Sidebar</h2>
                    <p class="text-gray-600 dark:text-gray-400 text-sm mb-6 flex-grow">A developer-focused layout with a fixed left sidebar for easy navigation. Emphasizes content hierarchy and a clean reading experience.</p>
                    
                    <!-- Features List -->
                    <ul class="space-y-3 mb-8">
                        <li class="flex items-center text-sm text-gray-700 dark:text-gray-300 font-medium">
                            <i class="fas fa-check-circle text-purple-500 mr-3 text-lg"></i> Fixed Left Sidebar Navigation
                        </li>
                        <li class="flex items-center text-sm text-gray-700 dark:text-gray-300 font-medium">
                            <i class="fas fa-check-circle text-purple-500 mr-3 text-lg"></i> Clean, Minimalist UI
                        </li>
                        <li class="flex items-center text-sm text-gray-700 dark:text-gray-300 font-medium">
                            <i class="fas fa-check-circle text-purple-500 mr-3 text-lg"></i> Vertical Education Timeline
                        </li>
                        <li class="flex items-center text-sm text-gray-700 dark:text-gray-300 font-medium">
                            <i class="fas fa-check-circle text-purple-500 mr-3 text-lg"></i> High-Contrast Reading Mode
                        </li>
                    </ul>

                    <!-- Action Button (Update href to match your exact route) -->
                    <a href="/portfolio/templateB" class="w-full block text-center py-4 rounded-xl bg-slate-800 dark:bg-slate-700 border-2 border-transparent hover:border-purple-500 text-white font-bold text-lg hover:shadow-lg transform transition-all duration-300">
                        Use Template B
                    </a>
                </div>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-white dark:bg-slate-900 py-8 border-t border-gray-200 dark:border-slate-800 mt-auto z-10 relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <p class="text-sm text-gray-500 dark:text-gray-400">
                &copy; <script>document.write(new Date().getFullYear())</script> Edufolio Builder. Select a template to preview your data.
            </p>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        // Initialize AOS animations
        AOS.init({
            once: true,
            offset: 50,
            duration: 800,
            easing: 'ease-out-cubic',
        });
    </script>
    
    <!-- Link to your modular scripts -->
    <script src="/js/darkmode.js"></script>
</body>
</html>